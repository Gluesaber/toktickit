// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Issue 3 (Lab 1) — IT request categories.
// Issue 2-2 (Lab 2) — gained `isActive` so "retrieve active Categories" (api-spec.md) is meaningful.
// See docs/lab-02/specification.md §7 and §11.
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

// Issue 2-2 (Lab 2) — Related Systems referenced by a Ticket (Email, VPN, Corporate Laptop, ...).
model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

// Issue 3-2 (Lab 3) — REQUESTER/IT_STAFF/ADMINISTRATOR per specification.md §5.1. One role per user
// in Lab 3 (BR — "multiple roles assigned to one user" is explicitly excluded, labsheet §4.2).
enum Role {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

// Issue 2-2 (Lab 2) — originally the "Development Requester," named `Requester` (not `DevRequester`)
// so it could be extended in place rather than migrated to a new table (BR-40/BR-41 there).
// Issue 3-2 (Lab 3) — renamed `Requester` -> `User` and extended with real credentials/role, exactly
// as anticipated: same table/ids, `Ticket.requesterId` never changes (docs/lab-03/specification.md
// §7 "Migration strategy", BR-37). `passwordHash`/`role` have no DB-level default (every insert sets
// them explicitly — see the hand-written migration SQL for how *existing* rows were backfilled
// one time only); `mustChangePassword` keeps its default so new rows are safe-by-default.
// `ownerId`/`itPriority` on Ticket (and the resulting second `ticketsOwned` relation here) are
// deliberately not part of this migration — see specification.md §11 "Migration scope": each later
// issue (3-4 Staff Queue, 3-5 Staff Ticket Ops) adds its own incremental migration when it actually
// needs those fields, rather than this issue carrying schema nothing yet uses.
model User {
  id                 Int      @id @default(autoincrement())
  name               String
  email              String   @unique
  passwordHash       String
  role               Role
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tickets Ticket[]
}

// Only `NEW` is ever written or read in Lab 2 (BR-02); the remaining values are reserved so Lab 3's
// status-workflow labs don't require a breaking schema change — see specification.md §11.
enum TicketStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED
  REOPENED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Issue 2-2 (Lab 2). `ticketNumber` is generated by the application after insert, using the
// pattern `TK-<creation year>-<6-digit zero-padded id>` (BR-05) — never supplied by the client.
model Ticket {
  id                Int          @id @default(autoincrement())
  ticketNumber      String       @unique
  requesterId       Int
  categoryId        Int
  relatedSystemId   Int
  summary           String
  description       String       @db.Text
  requestedPriority Priority
  currentStatus     TicketStatus @default(NEW)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  requester     User          @relation(fields: [requesterId], references: [id])
  category      Category      @relation(fields: [categoryId], references: [id])
  relatedSystem RelatedSystem @relation(fields: [relatedSystemId], references: [id])
  attachments   Attachment[]

  @@index([requesterId])
  @@index([categoryId])
  @@index([relatedSystemId])
  @@index([currentStatus])
  @@index([createdAt])
}

// Issue 2-2 (Lab 2). Soft removal only (BR-31): `removedAt IS NULL` means active. Never physically
// deleted in Lab 2.
model Attachment {
  id               Int       @id @default(autoincrement())
  ticketId         Int
  originalFileName String
  storedFileName   String
  mimeType         String
  fileSizeBytes    Int
  uploadedAt       DateTime  @default(now())
  removedAt        DateTime?
  removalReason    String?

  ticket Ticket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
}
