// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Issue 3 (Lab 1) — IT request categories.
// Issue 2-2 (Lab 2) — gained `isActive` so "retrieve active Categories" (api-spec.md) is meaningful.
// See docs/lab-02/specification.md §7 and §11.
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

// Issue 2-2 (Lab 2) — Related Systems referenced by a Ticket (Email, VPN, Corporate Laptop, ...).
model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

// Issue 2-2 (Lab 2) — the "Development Requester." Named `Requester`, not `DevRequester`: the
// underlying entity (a person who submits tickets) is permanent, only the Lab 2 *selection
// mechanism* around it is temporary (BR-40/BR-41). Lab 3 extends this same model with auth fields
// instead of introducing a parallel identity model — see specification.md §11.
model Requester {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

// Only `NEW` is ever written or read in Lab 2 (BR-02); the remaining values are reserved so Lab 3's
// status-workflow labs don't require a breaking schema change — see specification.md §11.
enum TicketStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED
  REOPENED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Issue 2-2 (Lab 2). `ticketNumber` is generated by the application after insert, using the
// pattern `TK-<creation year>-<6-digit zero-padded id>` (BR-05) — never supplied by the client.
model Ticket {
  id                Int          @id @default(autoincrement())
  ticketNumber      String       @unique
  requesterId       Int
  categoryId        Int
  relatedSystemId   Int
  summary           String
  description       String       @db.Text
  requestedPriority Priority
  currentStatus     TicketStatus @default(NEW)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  requester     Requester     @relation(fields: [requesterId], references: [id])
  category      Category      @relation(fields: [categoryId], references: [id])
  relatedSystem RelatedSystem @relation(fields: [relatedSystemId], references: [id])
  attachments   Attachment[]

  @@index([requesterId])
  @@index([categoryId])
  @@index([relatedSystemId])
  @@index([currentStatus])
  @@index([createdAt])
}

// Issue 2-2 (Lab 2). Soft removal only (BR-31): `removedAt IS NULL` means active. Never physically
// deleted in Lab 2.
model Attachment {
  id               Int       @id @default(autoincrement())
  ticketId         Int
  originalFileName String
  storedFileName   String
  mimeType         String
  fileSizeBytes    Int
  uploadedAt       DateTime  @default(now())
  removedAt        DateTime?
  removalReason    String?

  ticket Ticket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
}
