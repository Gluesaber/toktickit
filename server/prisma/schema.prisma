// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Issue 3 (Lab 1) — IT request categories.
// Issue 2-2 (Lab 2) — gained `isActive` so "retrieve active Categories" (api-spec.md) is meaningful.
// See docs/lab-02/specification.md §7 and §11.
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

// Issue 2-2 (Lab 2) — Related Systems referenced by a Ticket (Email, VPN, Corporate Laptop, ...).
model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

// Issue 3-2 (Lab 3) — REQUESTER/IT_STAFF/ADMINISTRATOR per specification.md §5.1. One role per user
// in Lab 3 (BR — "multiple roles assigned to one user" is explicitly excluded, labsheet §4.2).
enum Role {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

// Issue 2-2 (Lab 2) — originally the "Development Requester," named `Requester` (not `DevRequester`)
// so it could be extended in place rather than migrated to a new table (BR-40/BR-41 there).
// Issue 3-2 (Lab 3) — renamed `Requester` -> `User` and extended with real credentials/role, exactly
// as anticipated: same table/ids, `Ticket.requesterId` never changes (docs/lab-03/specification.md
// §7 "Migration strategy", BR-37). `passwordHash`/`role` have no DB-level default (every insert sets
// them explicitly — see the hand-written migration SQL for how *existing* rows were backfilled
// one time only); `mustChangePassword` keeps its default so new rows are safe-by-default.
// `ownerId`/`itPriority` on Ticket (and the resulting second `ticketsOwned` relation here) were
// deliberately not part of Issue 3-2's migration — see specification.md §11 "Migration scope": each
// issue adds its own incremental migration when it actually needs new fields. Issue 3-4 (Staff
// Queue) is the first to need them, since the Queue displays/filters/sorts by both.
model User {
  id                 Int      @id @default(autoincrement())
  name               String
  email              String   @unique
  passwordHash       String
  role               Role
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tickets      Ticket[]
  ticketsOwned Ticket[] @relation("TicketOwner")
  comments     Comment[]
  notes        Note[]

  // Issue 4-2 (Lab 4) — three separate roles a User can play on an Action (specification.md §7),
  // plus the changer of each status-history row.
  actionsPerformed ActionTaken[]         @relation("ActionPerformedBy")
  actionsAssigned  ActionTaken[]         @relation("ActionAssignee")
  actionsUpdated   ActionTaken[]         @relation("ActionUpdatedBy")
  statusChanges    TicketStatusHistory[]
}

// Only `NEW` is ever written or read through Lab 2 (BR-02); the remaining values were reserved so
// Lab 3's status-workflow labs wouldn't require a breaking schema change — see specification.md §11.
// Issue 3-4 (Lab 3) — `OPEN`/`WAITING_FOR_REQUESTER` added now (a purely additive enum change, no
// data migration needed) so the Staff Ticket Queue's status filter can honor its own already-written
// contract (api-spec.md §7: "any of the 8 status enum values") immediately, rather than shipping a
// filter two issues short of complete. Nothing produces these two values yet — that's Issue 3-5's
// transition endpoint — so no seeded or existing Ticket will actually have either status until then.
enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  CANCELLED
  REOPENED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Issue 2-2 (Lab 2). `ticketNumber` is generated by the application after insert, using the
// pattern `TK-<creation year>-<6-digit zero-padded id>` (BR-05) — never supplied by the client.
// Issue 3-3 (Lab 3) — `requesterConfirmedResolvedAt` added (BR-25): the Requester's "Problem Appears
// Resolved" indication. Purely informational — never touches `currentStatus`, which stays `NEW` for
// every Ticket until Issue 3-5 introduces the status-transition endpoint (specification.md §11,
// "Cancel scope" decision — the whole PATCH .../status endpoint, including the Requester's own
// self-Cancel case, is deferred there rather than split across two issues).
// Issue 3-4 (Lab 3) — `ownerId`/`itPriority` added. `itPriority` is initialized equal to
// `requestedPriority` at creation (BR-21) and is otherwise read-only until Issue 3-5's
// PATCH /api/staff/tickets/:id/priority exists; `ownerId` stays null (unassigned) for every Ticket
// until that same issue's claim/reassign endpoint exists — Issue 3-4 itself never writes either
// field, only reads them for the Queue's columns/filters/sort.
model Ticket {
  id                           Int          @id @default(autoincrement())
  ticketNumber                 String       @unique
  requesterId                  Int
  ownerId                      Int?
  categoryId                   Int
  relatedSystemId              Int
  summary                      String
  description                  String       @db.Text
  requestedPriority            Priority
  itPriority                   Priority
  currentStatus                TicketStatus @default(NEW)
  requesterConfirmedResolvedAt DateTime?
  // Issue 4-2 (Lab 4) — `version` is the optimistic-concurrency counter (BR-22, specification.md §7
  // decision 1): NOT NULL DEFAULT 1 so every existing Ticket lands on 1 in a single migration step.
  // `seedKey` exists only so the seed script can find its own rows again (BR-36, decision 3) — real
  // tickets keep it NULL, and Postgres allows any number of NULLs under the unique index.
  version                      Int          @default(1)
  seedKey                      String?      @unique @db.VarChar(32)
  createdAt                    DateTime     @default(now())
  updatedAt                    DateTime     @updatedAt

  requester     User                  @relation(fields: [requesterId], references: [id])
  owner         User?                 @relation("TicketOwner", fields: [ownerId], references: [id])
  category      Category              @relation(fields: [categoryId], references: [id])
  relatedSystem RelatedSystem         @relation(fields: [relatedSystemId], references: [id])
  attachments   Attachment[]
  comments      Comment[]
  notes         Note[]
  actions       ActionTaken[]
  statusHistory TicketStatusHistory[]

  @@index([requesterId])
  @@index([ownerId])
  @@index([categoryId])
  @@index([relatedSystemId])
  @@index([currentStatus])
  @@index([createdAt])
  @@index([updatedAt])
}

// Issue 4-2 (Lab 4) — Action status lifecycle, specification.md §5.3. COMPLETED and CANCELLED are
// final and lock the Action (BR-10).
enum ActionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Issue 4-2 (Lab 4) — Actions Taken (BR-01–BR-15). Its own model rather than a `kind` flag on
// Comment/Note: different fields, its own lifecycle, editable while not locked (§7 decision 5).
// `performedById` is the creator and never changes (BR-04); `assigneeId` is who is responsible
// (BR-05). Never deleted (BR-11). `clientRequestId` is never returned by the API — it only backs the
// per-Ticket unique constraint that makes a retried create return the same row (BR-14).
model ActionTaken {
  id               Int          @id @default(autoincrement())
  ticketId         Int
  actionAt         DateTime
  description      String       @db.Text
  result           String?      @db.Text
  status           ActionStatus
  performedById    Int
  assigneeId       Int
  followUpRequired Boolean      @default(false)
  followUpNote     String?      @db.Text
  attachmentNotes  String?      @db.VarChar(500)
  clientRequestId  String?      @db.VarChar(64)
  version          Int          @default(1)
  updatedById      Int?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  ticket      Ticket @relation(fields: [ticketId], references: [id])
  performedBy User   @relation("ActionPerformedBy", fields: [performedById], references: [id])
  assignee    User   @relation("ActionAssignee", fields: [assigneeId], references: [id])
  updatedBy   User?  @relation("ActionUpdatedBy", fields: [updatedById], references: [id])

  @@unique([ticketId, clientRequestId])
  @@index([ticketId, actionAt, id])
  @@index([assigneeId, status])
}

// Issue 4-2 (Lab 4) — append-only status history (BR-20, §7 decision 2). No `updatedAt` and no
// update/delete route anywhere. `fromStatus` NULL marks the creation entry. The table is created in
// this issue (one migration for all Lab 4 schema); the status endpoint starts writing to it in
// Issue 4-3 — only the seed writes rows before then.
model TicketStatusHistory {
  id          Int           @id @default(autoincrement())
  ticketId    Int
  fromStatus  TicketStatus?
  toStatus    TicketStatus
  changedById Int
  changedAt   DateTime      @default(now())

  ticket    Ticket @relation(fields: [ticketId], references: [id])
  changedBy User   @relation(fields: [changedById], references: [id])

  @@index([ticketId, changedAt, id])
  @@index([toStatus, changedAt])
}

// Issue 3-3 (Lab 3) — Public Comments (BR-04, BR-26–BR-28). Append-only in Lab 3: no `updatedAt`, no
// edit/delete route. Requester-only access at first (own ticket only) — Issue 3-5 extends the same
// `POST/GET /api/tickets/:id/comments` route with an IT Staff/Administrator branch (any ticket) now
// that the Staff Ticket Detail screen needing it exists; kept as its own model (not shared with
// `Note` below behind a `visibility` flag) so a query bug can never leak one into the other — see
// api-spec.md §4 / specification.md §11.
model Comment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  content   String   @db.Text
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
}

// Issue 3-5 (Lab 3) — Internal Notes (BR-04, BR-26–BR-28, AC-04). Same shape as `Comment` and the
// same append-only rules, but a fully separate model/table rather than a `visibility` flag on
// `Comment` — an authorization bug in one query path can't accidentally expose Note content through
// the Public Comments endpoint (specification.md §11). IT Staff/Administrator only, on any ticket;
// a Requester is rejected 403 before any Note row is ever read (BR-29).
model Note {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  content   String   @db.Text
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
}

// Issue 2-2 (Lab 2). Soft removal only (BR-31): `removedAt IS NULL` means active. Never physically
// deleted in Lab 2.
model Attachment {
  id               Int       @id @default(autoincrement())
  ticketId         Int
  originalFileName String
  storedFileName   String
  mimeType         String
  fileSizeBytes    Int
  uploadedAt       DateTime  @default(now())
  removedAt        DateTime?
  removalReason    String?

  ticket Ticket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
}
